{
  "name": "cmms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --target=bun-linux-x64 --outfile=cmms-api src/index.ts",
    "build:local": "bun build --compile --outfile=cmms-api src/index.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "bun-types": "^1.3.14",
    "typescript": "^5.4.5"
  }
}
