# cmms-api configuration
# Copy this file to .env and fill in the values.
# Bun loads .env automatically from the working directory.
# The systemd unit points at /etc/cmms-api.env with the same format.

# --- Database ---
# Path to the original cmms.db (read + write; the human CMMS app reads this too)
CMMS_DB_PATH=./cmms.db

# Path to the derived normalized DB. Rebuilt from cmms.db if deleted.
# CMMS_SPECIALIZED_DB=./cmms_specialized.db

# --- Server ---
# PORT=8787
# HOST=127.0.0.1

# --- Auth ---
# Bearer tokens. The read token is what kiloclaw sends.
# The write token is for humans/agents that create new jobs or append notes.
CMMS_API_TOKEN_READ=
CMMS_API_TOKEN_WRITE=

# --- Behavior ---
# Skip the full ETL on startup (only incremental). Useful for fast dev restarts.
# CMMS_SKIP_FULL_ETL=true
