# cmms-api configuration (pure-RAG build)
# Copy this file to .env and fill in the values.
# Bun loads .env automatically from the working directory.
# The systemd unit points at /etc/cmms-api.env with the same format.

# --- Database ---
# Path to the original cmms.db (read + write; the human CMMS app reads this too)
CMMS_DB_PATH=./cmms.db

# Path to the derived normalized DB (holds the FTS5 RAG index).
# Rebuilt from cmms.db if deleted.
# CMMS_SPECIALIZED_DB=./cmms_specialized.db

# --- Server ---
# PORT=8787
# HOST=0.0.0.0

# --- Auth ---
# Bearer token required on POST /v1/chat/completions.
# /v1/health is public.
CMMS_API_TOKEN_READ=
# (Write tokens no longer exist: this build has no write endpoints.)

# --- LLM (Kilo Gateway, OpenAI-compatible) ---
# If KILO_API_KEY is unset, /v1/chat/completions ships the deterministic
# evidence-only answer (matched tickets listed with sorszam + snippet)
# and skips the rewrite step entirely.
KILO_API_KEY=
# KILO_BASE_URL=https://api.kilo.ai/api/gateway
# KILO_MODEL=openai/gpt-5.6-luna-pro

# --- Behavior ---
# Skip the full ETL on startup (only incremental). Useful for fast dev restarts.
# CMMS_SKIP_FULL_ETL=true
